{
  "Comment": "Eon Bulk Recovery Workflow - Orchestrates the recovery of all resources from a source account to a restore account",
  "StartAt": "Apply Input Defaults",
  "States": {
    "Apply Input Defaults": {
      "Type": "Pass",
      "Comment": "Defaults for optional execution-input keys the state machine references by path",
      "Result": {
        "dynamodbRestoreMethod": "auto"
      },
      "ResultPath": "$.inputDefaults",
      "Next": "Normalize Input"
    },
    "Normalize Input": {
      "Type": "Pass",
      "Comment": "Caller-supplied values win over the defaults",
      "Parameters": {
        "merged.$": "States.JsonMerge($.inputDefaults, $, false)"
      },
      "OutputPath": "$.merged",
      "Next": "Resolve VPC Configs"
    },
    "Resolve VPC Configs": {
      "Type": "Task",
      "Resource": "${ResolveVpcConfigsFunctionArn}",
      "Comment": "Replace VPC, subnet, and security group names in vpcConfigs with IDs. Values that are already IDs pass through, and the resolved list overwrites vpcConfigs for every later step.",
      "Parameters": {
        "step": "resolve_vpc_configs",
        "restoreAccountId.$": "$.restoreAccountId",
        "restoreRegion.$": "$.restoreRegion",
        "vpcConfigs.$": "$.vpcConfigs",
        "crossAccountRoleArn.$": "$.crossAccountRoleArn"
      },
      "ResultPath": "$.vpcConfigs",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Resolve VPC Configs Failed"
        }
      ],
      "Next": "Bootstrap Restore Account"
    },
    "Resolve VPC Configs Failed": {
      "Type": "Fail",
      "Error": "ResolveVpcConfigsFailed",
      "Cause": "Failed to resolve VPC, subnet, or security group names to IDs in the restore account"
    },
    "Bootstrap Restore Account": {
      "Type": "Task",
      "Resource": "${BootstrapFunctionArn}",
      "Comment": "Deploy IAM permissions, create RDS subnet group, and create KMS key in the restore account",
      "Parameters": {
        "step": "bootstrap",
        "restoreAccountId.$": "$.restoreAccountId",
        "restoreRegion.$": "$.restoreRegion",
        "vpcConfigs.$": "$.vpcConfigs",
        "crossAccountRoleArn.$": "$.crossAccountRoleArn"
      },
      "ResultPath": "$.bootstrapResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Bootstrap Failed"
        }
      ],
      "Next": "Connect Restore Account"
    },
    "Bootstrap Failed": {
      "Type": "Fail",
      "Error": "BootstrapFailed",
      "Cause": "Failed to bootstrap the restore account with required IAM permissions and resources"
    },
    "Connect Restore Account": {
      "Type": "Task",
      "Resource": "${ConnectAccountFunctionArn}",
      "Comment": "Connect the restore account to Eon via the REST API",
      "Parameters": {
        "step": "connect_account",
        "roleArn.$": "$.bootstrapResult.roleArn",
        "restoreAccountId.$": "$.restoreAccountId",
        "restoreAccountName.$": "$.restoreAccountName"
      },
      "ResultPath": "$.connectResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Connect Account Failed"
        }
      ],
      "Next": "Configure VPC"
    },
    "Connect Account Failed": {
      "Type": "Fail",
      "Error": "ConnectAccountFailed",
      "Cause": "Failed to connect the restore account to Eon"
    },
    "Configure VPC": {
      "Type": "Task",
      "Resource": "${ConfigureVpcFunctionArn}",
      "Comment": "Configure VPC connectivity settings for the restore account in Eon",
      "Parameters": {
        "step": "configure_vpc",
        "eonRestoreAccountId.$": "$.connectResult.eonRestoreAccountId",
        "vpcConfigs.$": "$.vpcConfigs"
      },
      "ResultPath": "$.vpcConfigResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Configure VPC Failed"
        }
      ],
      "Next": "List Resources"
    },
    "Configure VPC Failed": {
      "Type": "Fail",
      "Error": "ConfigureVpcFailed",
      "Cause": "Failed to configure VPC connectivity for the restore account"
    },
    "List Resources": {
      "Type": "Task",
      "Resource": "${ListResourcesFunctionArn}",
      "Comment": "List all protected resources from the source account",
      "Parameters": {
        "step": "list_resources",
        "sourceAccountId.$": "$.sourceAccountId",
        "resourceTypes.$": "$.resourceTypes",
        "resourceIds.$": "$.resourceIds"
      },
      "ResultPath": "$.resourcesResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "List Resources Failed"
        }
      ],
      "Next": "Get Snapshots"
    },
    "List Resources Failed": {
      "Type": "Fail",
      "Error": "ListResourcesFailed",
      "Cause": "Failed to list protected resources from the source account"
    },
    "Get Snapshots": {
      "Type": "Task",
      "Resource": "${GetSnapshotsFunctionArn}",
      "Comment": "Retrieve snapshot IDs for all resources to restore",
      "Parameters": {
        "step": "get_snapshots",
        "resources.$": "$.resourcesResult.resources",
        "snapshotDate.$": "$.snapshotDate",
        "sourceAccountId.$": "$.sourceAccountId"
      },
      "ResultPath": "$.snapshotsResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Get Snapshots Failed"
        }
      ],
      "Next": "Check Snapshots Found"
    },
    "Get Snapshots Failed": {
      "Type": "Fail",
      "Error": "GetSnapshotsFailed",
      "Cause": "Failed to retrieve snapshots for resources"
    },
    "Check Snapshots Found": {
      "Type": "Choice",
      "Comment": "Stop the run if resources were found but none of them have a snapshot to restore from",
      "Choices": [
        {
          "Variable": "$.snapshotsResult.totalSnapshots",
          "NumericEquals": 0,
          "Next": "No Snapshots Found"
        }
      ],
      "Default": "Initiate Restores"
    },
    "No Snapshots Found": {
      "Type": "Fail",
      "Error": "NoSnapshotsFound",
      "Cause": "Resources were found in the source account, but none of them have a snapshot matching the requested snapshotDate. A notification listing the affected resources has been sent. Re-run with \"snapshotDate\": \"latest\" to restore each resource's most recent snapshot."
    },
    "Initiate Restores": {
      "Type": "Task",
      "Resource": "${InitiateRestoresFunctionArn}",
      "Comment": "Initiate restore jobs for all snapshots",
      "Parameters": {
        "step": "initiate_restores",
        "resourceSnapshots.$": "$.snapshotsResult.resourceSnapshots",
        "eonRestoreAccountId.$": "$.connectResult.eonRestoreAccountId",
        "restoreAccountId.$": "$.restoreAccountId",
        "restoreRegion.$": "$.restoreRegion",
        "kmsKeyArnsByRegion.$": "$.bootstrapResult.kmsKeyArnsByRegion",
        "rdsSubnetGroupsByRegion.$": "$.bootstrapResult.rdsSubnetGroupsByRegion",
        "dynamodbRegionalWcuLimit.$": "$.dynamodbRegionalWcuLimit",
        "dynamodbTableWcuMax.$": "$.dynamodbTableWcuMax",
        "dynamodbRestoreMethod.$": "$.dynamodbRestoreMethod",
        "resourceNamePrefix.$": "$.resourceNamePrefix",
        "vpcConfigs.$": "$.vpcConfigs",
        "crossAccountRoleArn.$": "$.crossAccountRoleArn",
        "excludeEC2TagKeys.$": "$.excludeEC2TagKeys",
        "recoveryStackNames.$": "$.recoveryStackNames",
        "recoveryStacksOnly.$": "$.recoveryStacksOnly",
        "s3InPlaceTagKey.$": "$.s3InPlaceTagKey"
      },
      "ResultPath": "$.restoreJobsResult",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Initiate Restores Failed"
        }
      ],
      "Next": "Initialize Monitoring"
    },
    "Initiate Restores Failed": {
      "Type": "Fail",
      "Error": "InitiateRestoresFailed",
      "Cause": "Failed to initiate restore jobs"
    },
    "Initialize Monitoring": {
      "Type": "Pass",
      "Comment": "Initialize the iteration counter for job monitoring",
      "Parameters": {
        "restoreJobs.$": "$.restoreJobsResult.restoreJobs",
        "iteration": 0,
        "sourceAccountId.$": "$.sourceAccountId",
        "restoreAccountId.$": "$.restoreAccountId",
        "restoreRegion.$": "$.restoreRegion",
        "vpcConfigs.$": "$.vpcConfigs",
        "crossAccountRoleArn.$": "$.crossAccountRoleArn",
        "wcuRestorationFailures": [],
        "resourcesWithoutSnapshots.$": "$.snapshotsResult.resourcesWithoutSnapshots",
        "resourcesWithoutSnapshotsCount.$": "$.snapshotsResult.resourcesWithoutSnapshotsCount",
        "startTime.$": "$$.State.EnteredTime"
      },
      "ResultPath": "$.monitoringState",
      "Next": "Monitor Jobs"
    },
    "Monitor Jobs": {
      "Type": "Task",
      "Resource": "${MonitorJobsFunctionArn}",
      "Comment": "Check the status of all restore jobs",
      "Parameters": {
        "step": "monitor_jobs",
        "restoreJobs.$": "$.monitoringState.restoreJobs",
        "iteration.$": "$.monitoringState.iteration",
        "sourceAccountId.$": "$.monitoringState.sourceAccountId",
        "restoreAccountId.$": "$.monitoringState.restoreAccountId",
        "restoreRegion.$": "$.monitoringState.restoreRegion",
        "vpcConfigs.$": "$.monitoringState.vpcConfigs",
        "crossAccountRoleArn.$": "$.monitoringState.crossAccountRoleArn",
        "wcuRestorationFailures.$": "$.monitoringState.wcuRestorationFailures",
        "resourcesWithoutSnapshots.$": "$.monitoringState.resourcesWithoutSnapshots",
        "resourcesWithoutSnapshotsCount.$": "$.monitoringState.resourcesWithoutSnapshotsCount",
        "startTime.$": "$.monitoringState.startTime"
      },
      "ResultPath": "$.monitoringState",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed",
            "States.Timeout"
          ],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Monitor Jobs Failed"
        }
      ],
      "Next": "Check If Complete"
    },
    "Monitor Jobs Failed": {
      "Type": "Fail",
      "Error": "MonitorJobsFailed",
      "Cause": "Failed to monitor restore job status"
    },
    "Check If Complete": {
      "Type": "Choice",
      "Comment": "Determine if all jobs are complete, if monitoring has timed out, or if we should keep polling",
      "Choices": [
        {
          "Variable": "$.monitoringState.allComplete",
          "BooleanEquals": true,
          "Next": "All Jobs Complete"
        },
        {
          "Variable": "$.monitoringState.timedOut",
          "BooleanEquals": true,
          "Next": "Monitoring Timed Out"
        }
      ],
      "Default": "Wait For Jobs"
    },
    "Wait For Jobs": {
      "Type": "Wait",
      "Comment": "Wait 5 minutes before checking job status again",
      "Seconds": 300,
      "Next": "Monitor Jobs"
    },
    "All Jobs Complete": {
      "Type": "Succeed",
      "Comment": "All restore jobs have completed (successfully or with failures)"
    },
    "Monitoring Timed Out": {
      "Type": "Fail",
      "Error": "MonitoringTimedOut",
      "Cause": "Monitoring reached the maximum iteration limit (MAX_MONITORING_ITERATIONS) with jobs still running. A timeout notification has been sent; check the Eon console for the final status of any still-running jobs."
    }
  }
}
